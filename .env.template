# Environment Variables for Unified Backend
# Copy to .env and fill in actual values

# AWS Configuration
AWS_REGION=us-east-2
AWS_ACCOUNT_ID=873363353263
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key

# Environment
ENVIRONMENT=production
LOG_LEVEL=INFO

# DynamoDB Tables (set by Terraform in production)
DYNAMODB_ENDPOINT=http://localhost:8000  # Local dev
DYNAMODB_WORKFLOWS_TABLE=unified-backend-workflows
DYNAMODB_EXECUTIONS_TABLE=unified-backend-executions
DYNAMODB_AUDIT_TABLE=unified-backend-audit
DYNAMODB_TEMPLATES_TABLE=unified-backend-templates

# Redis/Upstash (for caching and streaming)
UPSTASH_REDIS_URL=redis://localhost:6379
UPSTASH_REDIS_TOKEN=your-upstash-token

# CORS Configuration (comma-separated origins)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,https://myfamilyassistant.ai,https://squark.ai,https://squark-web.ai

# LLM API Keys (for real integration)
OPENAI_API_KEY=sk-your-key
ANTHROPIC_API_KEY=your-anthropic-key
AWS_BEDROCK_REGION=us-east-2

# Lambda Configuration
AWS_LAMBDA_FUNCTION_NAME=unified-agentic-backend-api
AWS_LAMBDA_MEMORY_MB=512
AWS_LAMBDA_TIMEOUT_SECONDS=30

# Monitoring
ENABLE_MONITORING=true
CLOUDWATCH_LOG_RETENTION_DAYS=7

# Feature Flags
ENABLE_AUDIT_LOGGING=true
ENABLE_COST_TRACKING=true
ENABLE_STREAMING=true
MAX_CONCURRENT_EXECUTIONS=100
EXECUTION_CACHE_TTL_HOURS=24

# Development
DEBUG=false
RELOAD=false
